{
  "name": "dipl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ant-design/charts": "^2.4.0",
    "@ant-design/icons": "^5.4.0",
    "@react-pdf/renderer": "4.9.0",
    "@reduxjs/toolkit": "^2.2.7",
    "@smit9313/abss-pdf": "1.0.6",
    "antd": "^5.22.5",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "firebase": "^12.13.0",
    "formik": "^2.4.6",
    "html2pdf.js": "^0.10.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga4": "^3.0.1",
    "react-organizational-chart": "^2.2.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.8.1",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5",
    "yup": "^1.4.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "build:analyze": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build --mode analyze",
    "preview": "vite preview",
    "lint": "eslint src/**/*.js src/**/*.jsx",
    "lint-staged": "lint-staged",
    "prepare": "husky install",
    "format": "prettier --write src/**/*.{js,jsx,json,css,html,md}",
    "format:check": "prettier --check src/**/*.{js,jsx,json,css,html,md}"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.36.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "postcss": "^8.5.6",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "vite": "^5.1.4"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "@react-pdf/renderer": "$@react-pdf/renderer",
    "@react-pdf/layout": "5.2.0",
    "@react-pdf/textkit": "7.0.1",
    "@react-pdf/font": "4.1.2",
    "@react-pdf/render": "4.7.0",
    "@react-pdf/stylesheet": "6.3.2"
  }
}